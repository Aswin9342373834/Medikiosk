# MediKiosk Frontend Environment Variables
# Copy this file to .env.local for local development

# Local Development:
# NEXT_PUBLIC_API_URL=http://localhost:5000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Vercel Production Deployment:
# Set these in Vercel Dashboard -> Project Settings -> Environment Variables:
# NEXT_PUBLIC_API_URL=https://<your-render-app-name>.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://<your-render-app-name>.onrender.com
# BACKEND_URL=https://<your-render-app-name>.onrender.com

NEXT_PUBLIC_API_URL=https://<your-render-app-name>.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://<your-render-app-name>.onrender.com
BACKEND_URL=https://<your-render-app-name>.onrender.com
