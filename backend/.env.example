# MediKiosk Backend Environment Configuration
# Copy this file to .env for local development

# Server Port (Render sets this dynamically)
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=production

# MongoDB Database Connection String
# Local: mongodb://127.0.0.1:27017/medikiosk
# Production (Render): mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/medikiosk?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/medikiosk?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a random 32+ character string in production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application Origin (For CORS whitelist)
# Multiple origins can be comma-separated: http://localhost:3000,https://medikiosk-mauve-tau.vercel.app
CLIENT_URL=https://medikiosk-mauve-tau.vercel.app

# Optional AI / Clinical Intake LLM Configuration (fallback defaults to deterministic structuring if unavailable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
